{
  "name": "dana-keluarga-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --ignore-path ../.prettierignore --write src tests scripts *.json *.js *.ts",
    "format:check": "prettier --ignore-path ../.prettierignore --check src tests scripts *.json *.js *.ts",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build:mobile": "tsc -b && vite build --mode mobile",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:doctor": "cap doctor",
    "mobile:assets": "node scripts/mobile-assets.mjs",
    "mobile:apk": "npm run mobile:sync && cd android && ./gradlew assembleDebug",
    "mobile:aab": "npm run mobile:sync && cd android && ./gradlew bundleRelease",
    "dev:lan": "vite --mode lan"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
