generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FamilyRole {
  ADMIN
  MEMBER
  TREASURER
}
enum SystemRole {
  SUPER_ADMIN
  USER
}
enum MembershipStatus {
  ACTIVE
  INACTIVE
}
enum LedgerDirection {
  IN
  OUT
}
enum LedgerType {
  INITIAL_BALANCE
  CONTRIBUTION
  WITHDRAWAL
  OTHER_INCOME
  EXPENSE
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  GOAL_CONTRIBUTION
  ADJUSTMENT
  REVERSAL
}
enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  PAID_OFF
  CANCELLED
}
enum InstallmentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}
enum PaymentProvider {
  MANUAL
  MIDTRANS
  XENDIT
  DOKU
  SANDBOX
}
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED
}
enum NotificationType {
  LOAN_REQUESTED
  LOAN_APPROVED
  LOAN_REJECTED
  INSTALLMENT_DUE
  PAYMENT_SUCCESS
  LOAN_PAID_OFF
  GENERAL
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String? @unique
  phone String @unique
  passwordHash String
  systemRole SystemRole @default(USER)
  avatarUrl String?
  isActive Boolean @default(true)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships FamilyMember[]
  loans Loan[] @relation("BorrowerLoans")
  approvedLoans Loan[] @relation("ApprovedLoans")
  rejectedLoans Loan[] @relation("RejectedLoans")
  contributionEntries LedgerEntry[] @relation("ContributionOwner")
  fundRequests FundRequest[]
  emailMessages EmailMessage[]
  ledgerEntries LedgerEntry[]
  notifications Notification[]
  auditLogs AuditLog[]
  refreshTokens RefreshToken[]
  createdApprovalPolicies ApprovalPolicy[] @relation("PolicyCreator")
  approvalAssignments ApprovalAssignment[]
  approvalRequests ApprovalRequest[] @relation("RequestMaker")
  approvalSteps ApprovalStep[]
  approvalActions ApprovalAction[]
  reviewedPayments Payment[] @relation("PaymentReviewer")
  createdBankAccounts FamilyBankAccount[] @relation("BankAccountCreator")
}

model Family {
  id String @id @default(uuid()) @db.Uuid
  name String
  code String @unique
  description String?
  currency String @default("IDR")
  createdById String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships FamilyMember[]
  loans Loan[]
  fundRequests FundRequest[]
  emailMessages EmailMessage[]
  ledgerEntries LedgerEntry[]
  goals FundGoal[]
  payments Payment[]
  bankAccounts FamilyBankAccount[]
  notifications Notification[]
  auditLogs AuditLog[]
  approvalPolicies ApprovalPolicy[]
  approvalRequests ApprovalRequest[]
}

model FamilyMember {
  id String @id @default(uuid()) @db.Uuid
  familyId String @db.Uuid
  userId String @db.Uuid
  role FamilyRole @default(MEMBER)
  status MembershipStatus @default(ACTIVE)
  joinedAt DateTime @default(now())
  family Family @relation(fields: [familyId], references: [id])
  user User @relation(fields: [userId], references: [id])
  @@unique([familyId, userId])
  @@index([familyId])
  @@index([userId])
}

model LedgerEntry {
  id String @id @default(uuid()) @db.Uuid
  familyId String @db.Uuid
  type LedgerType
  direction LedgerDirection
  amount Decimal @db.Decimal(18, 2)
  description String
  ownerUserId String? @db.Uuid
  owner User? @relation("ContributionOwner", fields: [ownerUserId], references: [id])
  balanceBefore Decimal? @db.Decimal(18, 2)
  balanceAfter Decimal? @db.Decimal(18, 2)
  idempotencyKey String?
  referenceType String?
  referenceId String?
  createdById String @db.Uuid
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())
  family Family @relation(fields: [familyId], references: [id])
  createdBy User @relation(fields: [createdById], references: [id])
  @@unique([familyId, createdById, idempotencyKey])
  @@index([familyId, ownerUserId, type])
  @@index([familyId, occurredAt])
}

model Loan {
  id String @id @default(uuid()) @db.Uuid
  familyId String @db.Uuid
  borrowerId String @db.Uuid
  principalAmount Decimal @db.Decimal(18, 2)
  tenorMonths Int
  purpose String
  requestedAt DateTime @default(now())
  status LoanStatus @default(PENDING)
  approvedById String? @db.Uuid
  approvedAt DateTime?
  rejectedById String? @db.Uuid
  rejectedAt DateTime?
  rejectionReason String?
  disbursedAt DateTime?
  paidOffAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  family Family @relation(fields: [familyId], references: [id])
  borrower User @relation("BorrowerLoans", fields: [borrowerId], references: [id])
  approvedBy User? @relation("ApprovedLoans", fields: [approvedById], references: [id])
  rejectedBy User? @relation("RejectedLoans", fields: [rejectedById], references: [id])
  fundRequest FundRequest?
  installments LoanInstallment[]
  payments Payment[]
  approvalRequestId String? @unique @db.Uuid
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])
  @@index([familyId, status])
  @@index([borrowerId])
}

model LoanInstallment {
  id String @id @default(uuid()) @db.Uuid
  loanId String @db.Uuid
  installmentNumber Int
  dueDate DateTime
  principalAmount Decimal @db.Decimal(18, 2)
  paidAmount Decimal @default(0) @db.Decimal(18, 2)
  remainingAmount Decimal @db.Decimal(18, 2)
  status InstallmentStatus @default(UNPAID)
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  loan Loan @relation(fields: [loanId], references: [id])
  payments Payment[]
  @@unique([loanId, installmentNumber])
  @@index([dueDate, status])
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  familyId String @db.Uuid
  loanId String @db.Uuid
  installmentId String @db.Uuid
  payerId String @db.Uuid
  amount Decimal @db.Decimal(18, 2)
  provider PaymentProvider
  externalId String @unique
  providerReference String?
  qrisPayload String?
  qrisUrl String?
  status PaymentStatus @default(PENDING)
  expiresAt DateTime?
  paidAt DateTime?
  rawCallback Json?
  bankAccountId String? @db.Uuid
  transferReference String?
  transferredAt DateTime?
  transferNotes String?
  reviewedById String? @db.Uuid
  reviewedAt DateTime?
  reviewNotes String?
  bankAccount FamilyBankAccount? @relation(fields: [bankAccountId, familyId], references: [id, familyId], onDelete: Restrict)
  reviewedBy User? @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  family Family @relation(fields: [familyId], references: [id])
  loan Loan @relation(fields: [loanId], references: [id])
  installment LoanInstallment @relation(fields: [installmentId], references: [id])
  @@index([loanId])
  @@index([installmentId])
  @@index([status])
}

// Append-only versions preserve the destination used for each reported transfer.
model FamilyBankAccount {
  id String @id @default(uuid()) @db.Uuid
  familyId String @db.Uuid
  version Int
  bankName String
  accountNumber String
  accountHolder String
  createdById String @db.Uuid
  createdAt DateTime @default(now())
  family Family @relation(fields: [familyId], references: [id])
  createdBy User @relation("BankAccountCreator", fields: [createdById], references: [id])
  payments Payment[]
  @@unique([familyId, version])
  @@unique([id, familyId])
}

model FundGoal {
  id String @id @default(uuid()) @db.Uuid
  familyId String @db.Uuid
  name String
  description String?
  targetAmount Decimal @db.Decimal(18, 2)
  targetDate DateTime?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  family Family @relation(fields: [familyId], references: [id])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  familyId String? @db.Uuid
  type NotificationType
  title String
  message String
  isRead Boolean @default(false)
  metadata Json?
  createdAt DateTime @default(now())
  readAt DateTime?
  user User @relation(fields: [userId], references: [id])
  family Family? @relation(fields: [familyId], references: [id])
  @@index([userId, isRead])
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  familyId String? @db.Uuid
  action String
  entityType String
  entityId String
  before Json?
  after Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  actor User @relation(fields: [actorId], references: [id])
  family Family? @relation(fields: [familyId], references: [id])
  @@index([familyId, createdAt])
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@index([userId, revokedAt])
}

enum WorkflowPermission {
  MAKER
  APPROVER
  RELEASER
}

enum ApprovalTransactionType {
  LOAN
  SAVINGS_WITHDRAWAL
  DEPOSIT_VERIFICATION
}

enum ApprovalRequestStatus {
  PENDING_APPROVAL
  PENDING_RELEASE
  RELEASED
  REJECTED
  RETURNED
  CANCELLED
}

enum ApprovalStepStatus {
  WAITING
  APPROVED
  REJECTED
  RETURNED
  RELEASED
}

enum ApprovalActionType {
  SUBMIT
  APPROVE
  REJECT
  RETURN
  RELEASE
  CANCEL
}

model ApprovalPolicy {
  id                     String                  @id @default(uuid()) @db.Uuid
  familyId               String                  @db.Uuid
  transactionType        ApprovalTransactionType @default(LOAN)
  version                Int
  active                 Boolean                 @default(true)
  distinctActorsRequired Boolean                 @default(true)
  createdById            String                  @db.Uuid
  reason                 String
  createdAt              DateTime                @default(now())
  family                 Family                  @relation(fields: [familyId], references: [id])
  createdBy              User                    @relation("PolicyCreator", fields: [createdById], references: [id])
  assignments            ApprovalAssignment[]
  requests               ApprovalRequest[]

  @@unique([familyId, transactionType, version])
  @@index([familyId, transactionType, active])
}

model ApprovalAssignment {
  id         String             @id @default(uuid()) @db.Uuid
  policyId   String             @db.Uuid
  userId     String             @db.Uuid
  permission WorkflowPermission
  sequence   Int
  policy     ApprovalPolicy     @relation(fields: [policyId], references: [id])
  user       User               @relation(fields: [userId], references: [id])

  @@unique([policyId, permission, sequence])
  @@unique([policyId, permission, userId])
  @@index([userId, permission])
}

model ApprovalRequest {
  id              String                  @id @default(uuid()) @db.Uuid
  familyId        String                  @db.Uuid
  policyId        String                  @db.Uuid
  transactionType ApprovalTransactionType @default(LOAN)
  referenceId     String                  @db.Uuid
  makerId         String                  @db.Uuid
  amount          Decimal                 @db.Decimal(18, 2)
  status          ApprovalRequestStatus   @default(PENDING_APPROVAL)
  currentStep     Int                     @default(1)
  submittedAt     DateTime                @default(now())
  completedAt     DateTime?
  updatedAt       DateTime                @updatedAt
  family          Family                  @relation(fields: [familyId], references: [id])
  policy          ApprovalPolicy          @relation(fields: [policyId], references: [id])
  maker           User                    @relation("RequestMaker", fields: [makerId], references: [id])
  steps           ApprovalStep[]
  actions         ApprovalAction[]
  loan            Loan?

  @@unique([transactionType, referenceId])
  @@index([familyId, status, submittedAt])
  @@index([makerId, status])
}

model ApprovalStep {
  id             String             @id @default(uuid()) @db.Uuid
  requestId      String             @db.Uuid
  sequence       Int
  permission     WorkflowPermission
  assignedUserId String             @db.Uuid
  status         ApprovalStepStatus @default(WAITING)
  actedAt        DateTime?
  request        ApprovalRequest    @relation(fields: [requestId], references: [id])
  assignedUser   User               @relation(fields: [assignedUserId], references: [id])

  @@unique([requestId, sequence])
  @@index([assignedUserId, status])
}

model ApprovalAction {
  id        String             @id @default(uuid()) @db.Uuid
  requestId String             @db.Uuid
  step      Int
  actorId   String             @db.Uuid
  action    ApprovalActionType
  beforeStatus ApprovalRequestStatus?
  afterStatus ApprovalRequestStatus?
  notes     String?
  actedAt   DateTime           @default(now())
  request   ApprovalRequest    @relation(fields: [requestId], references: [id])
  actor     User               @relation(fields: [actorId], references: [id])

  @@unique([requestId, step, action])
  @@index([actorId, actedAt])
}

// Pending requests reserve liquidity and the member contribution until final release.
model FundRequest {
  id String @id @default(uuid()) @db.Uuid
  familyId String @db.Uuid
  userId String @db.Uuid
  idempotencyKey String
  amount Decimal @db.Decimal(18, 2)
  withdrawalAmount Decimal @db.Decimal(18, 2)
  loanAmount Decimal @db.Decimal(18, 2)
  purpose String
  tenorMonths Int
  status LoanStatus @default(PENDING)
  loanId String? @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  family Family @relation(fields: [familyId], references: [id])
  user User @relation(fields: [userId], references: [id])
  loan Loan? @relation(fields: [loanId], references: [id])
  @@unique([familyId, userId, idempotencyKey])
  @@index([familyId, status])
}

enum EmailStatus {
  QUEUED
  PROCESSING
  SENT
  SIMULATED
  FAILED
  CANCELLED
}
model EmailMessage {
  id String @id @default(uuid()) @db.Uuid
  eventKey String @unique
  userId String @db.Uuid
  familyId String @db.Uuid
  subject String
  body String
  status EmailStatus @default(QUEUED)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedAt DateTime?
  completedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  family Family @relation(fields: [familyId], references: [id])
  @@index([status, nextAttemptAt])
}
