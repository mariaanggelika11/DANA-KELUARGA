{
  "name": "dana-keluarga-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --ignore-path ../.prettierignore --write src tests scripts prisma/seed.ts *.json *.mjs",
    "format:check": "prettier --ignore-path ../.prettierignore --check src tests scripts prisma/seed.ts *.json *.mjs",
    "test": "vitest run",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "test:cash:integration": "node scripts/run-family-cash-check.cjs",
    "email:check": "tsx scripts/check-email.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "prisma": "^6.19.3",
    "resend": "^6.32.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.2.1",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^9.33.0",
    "prettier": "^3.8.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.4"
  }
}
