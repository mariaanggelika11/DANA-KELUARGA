NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dana_keluarga?schema=public"
JWT_ACCESS_SECRET=replace-with-a-long-secret
JWT_REFRESH_SECRET=replace-with-another-long-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=Asia/Jakarta
# Intended main sender, international format 62...; set the real number only in .env.
# simulation records previews; disabled cancels new messages and pauses processing.
REMINDER_HOUR_WIB=9
NOTIFICATION_POLL_MS=30000
PAYMENT_PROVIDER=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
SEED_SUPER_ADMIN_NAME=Pemilik Aplikasi
SEED_SUPER_ADMIN_EMAIL=owner@example.com
SEED_SUPER_ADMIN_PHONE=628123456789
SEED_SUPER_ADMIN_PASSWORD=change-me-now


# Email notifications: disabled | simulation | smtp. Simulation never sends real email.
EMAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Dana Keluarga <no-reply@example.com>"
