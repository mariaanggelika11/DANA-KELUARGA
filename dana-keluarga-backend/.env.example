NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dana_keluarga?schema=public"
JWT_ACCESS_SECRET=replace-with-a-long-secret
JWT_REFRESH_SECRET=replace-with-another-long-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
# Optional public HTTPS app URL for email links when the API is run locally.
# In production FRONTEND_URL must also be the public HTTPS frontend origin.
PUBLIC_APP_URL=
APP_TIMEZONE=Asia/Jakarta
# Intended main sender, international format 62...; set the real number only in .env.
# simulation records previews; disabled cancels new messages and pauses processing.
REMINDER_HOUR_WIB=9
NOTIFICATION_POLL_MS=30000
# Cicilan memakai transfer manual. Pengelola dana mengatur rekening melalui Pengaturan.
# Optional first setup: fill in the real application owner's details before prisma:seed.
# This creates only the Super Admin; no family, membership, balance, or transaction is seeded.
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PHONE=
SEED_SUPER_ADMIN_PASSWORD=


# Email notifications: disabled | simulation | smtp | resend. Simulation never sends real email.
# Switch provider by changing EMAIL_MODE (and its credentials), then restart the API.
EMAIL_MODE=disabled
# Sender for both providers; must be verified at the active provider.
# Brevo requires domain authentication (DKIM/DMARC), otherwise it may rewrite From to brevosend.com.
# Verification in Resend does not authenticate the domain in Brevo, or vice versa.
EMAIL_FROM="Dana Keluarga <no-reply@example.com>"
EMAIL_REPLY_TO=
# EMAIL_MODE=smtp, e.g. Brevo: smtp-relay.brevo.com, SMTP login + SMTP key from Brevo > SMTP & API.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# EMAIL_MODE=resend: API key with sending access; EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
